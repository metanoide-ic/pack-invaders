; Diarrhena — projeto Godot 4
; Protótipo de movimentação: parkour em primeira pessoa com sistema de
; loadout (3 slots de arma no mouse + 2 slots de suporte em R/C, cada um
; trocável por uma habilidade de um pool maior). Ver README.md pros
; controles completos e o que falta pro vertical slice.

config_version=5

[application]

config/name="Diarrhena"
config/description="Protótipo de parkour/PvE em primeira pessoa — movimentação escatológica."
run/main_scene="res://levels/parkour_test_arena.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.06, 0.05, 0.04, 1)

[autoload]

GameEvents="*res://common/game_events.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
environment/ssao/enabled=true
environment/glow/enabled=true

[physics]

; Gravidade mais forte que o padrão (9.8) de propósito — parkour arcade
; quer queda rápida e leitura de salto precisa, não simulação realista.
3d/default_gravity=22.0
common/enable_object_picking=true

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
